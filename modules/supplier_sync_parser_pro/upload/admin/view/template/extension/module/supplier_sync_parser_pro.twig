<script>
(function($){
  var ccpModuleEnabled = {{ module_supplier_sync_parser_pro_status ? 'true' : 'false' }};
  var ccpActiveSupplierId = {{ supplier.supplier_id ? supplier.supplier_id : 0 }};
  var ccpBaseCurrency = '{{ base_currency|e('js') }}';
  var ccpSupplierStorageKey = 'ccp_ssp_active_supplier_id';
  var ccpStopStorageKey = 'ccp_ssp_queue_stop_requested';
  function ccpStoreActiveSupplier(id){id=parseInt(id||0,10)||0;ccpActiveSupplierId=id;try{if(id>0){window.localStorage.setItem(ccpSupplierStorageKey,String(id));}else{window.localStorage.removeItem(ccpSupplierStorageKey);}}catch(e){}}
  function ccpGetStoredSupplier(){try{return parseInt(window.localStorage.getItem(ccpSupplierStorageKey)||0,10)||0;}catch(e){return 0;}}
  function ccpMarkStopRequested(on){try{if(on){window.localStorage.setItem(ccpStopStorageKey,String(Date.now()));}else{window.localStorage.removeItem(ccpStopStorageKey);}}catch(e){}}
  function ccpIsStopRequested(){try{return !!window.localStorage.getItem(ccpStopStorageKey);}catch(e){return false;}}
  function syncSourcePanels(){ $('.ccp-feed-fields').toggle($('#form-supplier [name=source_type]').val()==='feed'); }
  $(document).on('change','#form-supplier [name=source_type]',syncSourcePanels);
  syncSourcePanels();
  function setSwitchState($switch, value){
    value = String(value) === '1' ? '1' : '0';
    var on = value === '1';
    $switch.attr('data-value', value).toggleClass('is-on', on).attr('aria-pressed', on ? 'true' : 'false');
    $switch.find('.ccp-switch-text').text(on ? '{{ text_enabled|e('js') }}' : '{{ text_disabled|e('js') }}');
    var target = $switch.data('target');
    if (target) { $(target).val(value); }
  }
  function syncModuleStatus(value){
    value = String(value) === '1' ? '1' : '0';
    ccpModuleEnabled = value === '1';
    $('#ccp-module-status-hidden').val(value);
    $('#ccp-module-status-control').val(value);
  }
  $(document).on('change','#ccp-module-status-control',function(){syncModuleStatus($(this).val());});
  $(document).on('click','.ccp-switch',function(){
    var $switch = $(this);
    if ($switch.hasClass('ccp-supplier-row-switch')) { return; }
    var next = String($switch.attr('data-value') || '0') === '1' ? '0' : '1';
    setSwitchState($switch, next);
  });
  if (!ccpModuleEnabled) {
    $('#btn-auto-detect,#btn-rules-auto-detect,#btn-rules-detect-list-links,#btn-rules-scan-save,#btn-rules-apply-detected-to-form,#btn-rules-save-detected-rules,#btn-save-detected-rules,#btn-apply-detected-to-form,#btn-test-product,#btn-scan-site-all,#btn-build-scan,#btn-build-sitemap,#btn-build-product-urls,#btn-build-linked,#btn-build-new-only,#btn-build-feed-file,#btn-run-queue,#btn-run-until-done,#btn-run-scan-batch,#btn-run-products-batch,#btn-run-products-until-done,#btn-run-feed-until-done,#btn-run-selected-scan,#btn-run-selected-products,#btn-clear-queue,#btn-reset-processing,#btn-recover-errors,#btn-stop-queue,#btn-resume-queue,#btn-clear-history,#btn-clear-logs,#btn-cleanup-old-data,#btn-clear-reviews,#btn-create-new-tab,#btn-queue-retry-selected,#btn-queue-delete-selected,#btn-new-skip-selected,#btn-new-restore-selected,#btn-delete-new-selected,#btn-delete-review-selected,.ccp-apply,.ccp-row-apply,.ccp-search-product,.ccp-match-product-btn,#btn-exclude-selected').prop('disabled', true).addClass('ccp-operation-disabled');
  }
  var ccpCurrentXhr=null; var ccpAbortRequested=false;
  function setAjaxBusy(on){$('#ccp-ajax-indicator').toggle(!!on);$('.ccp-ssp').toggleClass('ccp-queue-loop-active', !!on && ccpQueueLoopRunning);} 
  function toast(text){if(!text){return;}var box=$('#ccp-toast');box.text(text).stop(true,true).fadeIn(160).delay(3600).fadeOut(280);} 

  function ccpFallbackCopy(text){var tmp=$('<textarea readonly></textarea>').css({position:'fixed',left:'-9999px',top:'-9999px'}).val(text);$('body').append(tmp);tmp[0].select();try{document.execCommand('copy');}catch(e){}tmp.remove();}
  $(document).on('click','.ccp-copy-url',function(){var btn=$(this), text=String(btn.attr('data-copy')||'');if(!text){return;}var done=function(){btn.addClass('copied');toast('{{ text_copied|default('Ссылка скопирована')|e('js') }}');setTimeout(function(){btn.removeClass('copied');},900);};if(navigator.clipboard && navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(done,function(){ccpFallbackCopy(text);done();});}else{ccpFallbackCopy(text);done();}});

  function parseJsonResponse(response){
    var text = response === undefined || response === null ? '' : String(response);
    try { return JSON.parse(text); } catch(e) {}
    var start = text.indexOf('{'), end = text.lastIndexOf('}');
    if (start >= 0 && end > start) {
      try { return JSON.parse(text.substring(start, end + 1)); } catch(e2) {}
    }
    return {ok:false,message:'{{ text_ajax_invalid_json|e('js') }} '+text.substring(0,700)};
  }
  function ccpLooksLikeProductUrl(url){
    url=String(url||'').trim();
    if(!url){return false;}
    var a=document.createElement('a');a.href=url;
    var path=String(a.pathname||'').toLowerCase();
    var query=String(a.search||'').toLowerCase();
    if(query.indexOf('product_id=')>=0 || path.indexOf('/product/')>=0){return true;}
    if(/\/(cart|checkout|account|compare|wishlist|login|register|contact|blog|news|stati|information|manufacturer|delivery|oplata|about|testimonials)(\/|$)/.test(path)){return false;}
    var parts=path.replace(/^\/+|\/+$/g,'').split('/').filter(Boolean);
    if(!parts.length){return false;}
    var last=parts[parts.length-1];
    if(/^(filtry|filters|nasosy|pumpy|shlangi|hoses|schetchiki|meters|pistolety|komplekty|baki|emkosti|aksessuary|zapchasti|oborudovanie)[-_]?(page|p)?[0-9]+$/i.test(last)){return false;}
    if(/[0-9]/.test(last) && /[a-zа-яієїґ]/i.test(last) && /[-_]/.test(last)){return true;}
    if(/^p[0-9]{4,}[-_a-z0-9]*\.html$/i.test(last)){return true;}
    if(/[a-zа-яієїґ]{2,}[0-9]{2,}|[0-9]{2,}[a-zа-яієїґ]{2,}/i.test(last)){return true;}
    if(parts.length>=2 && /[a-zа-яієїґ]+[-_][a-zа-яієїґ0-9]+[-_][a-zа-яієїґ0-9]+/i.test(last)){return true;}
    return false;
  }

  function post(url, data, cb){
    data=data||{};var silent=!!data.__silent;if(silent){delete data.__silent;}
    var btn=!silent ? $(document.activeElement).filter('button,a.btn') : $();
    if(!silent){setAjaxBusy(true);if(btn.length){btn.data('ccp-old-disabled',btn.prop('disabled')).prop('disabled',true).addClass('disabled');}}
    var xhr=$.ajax({url:url,type:'post',data:data,dataType:'text',success:function(response){var json=parseJsonResponse(response);if(!silent && json.message){toast(json.message);}if(cb){cb(json);}},error:function(xhr){if(xhr.statusText==='abort'){if(cb){cb({ok:false,aborted:true,message:'{{ text_success_queue_stopped|e('js') }}'});}return;}var response=xhr.responseText||'';var json=response?parseJsonResponse(response):{ok:false,message:'{{ text_ajax_error|e('js') }} '+xhr.status};if(!json.message){json.message='{{ text_ajax_error|e('js') }} '+xhr.status;}if(cb){cb(json);}if(!silent){toast(json.message);}},complete:function(){if(ccpCurrentXhr===xhr){ccpCurrentXhr=null;}if(!silent){setAjaxBusy(false);if(btn.length && !btn.data('ccp-old-disabled')){btn.prop('disabled',false).removeClass('disabled');}}}});
    if(!silent){ccpCurrentXhr=xhr;}
    return xhr;
  }
  $(document).on('click','.ccp-supplier-row-switch',function(){
    var $switch=$(this), oldValue=String($switch.attr('data-value')||'0'), next=oldValue==='1'?'0':'1', supplierId=parseInt($switch.data('supplier-id')||0,10), row=$switch.closest('tr');
    if(!supplierId){return;}
    post('{{ ajax_toggle_supplier_status }}',{supplier_id:supplierId,status:next},function(json){
      if(json.ok){setSwitchState($switch,next);row.find('.ccp-supplier-list-status-text').text(next==='1'?'{{ text_enabled|e('js') }}':'{{ text_disabled|e('js') }}');if(String($('#supplier-id').val()||'0')===String(supplierId)){$('#ccp-supplier-status-hidden').val(next);}}
      else{setSwitchState($switch,oldValue);toast(json.message||'{{ text_ajax_error|e('js') }}');}
    });
  });
  $(document).on('click','.ccp-delete-supplier',function(){
    var supplierId=parseInt($(this).data('supplier-id')||0,10), row=$(this).closest('tr');
    if(!supplierId || !confirm('{{ text_confirm_delete_supplier|e('js') }}')){return;}
    post('{{ ajax_delete_supplier }}',{supplier_id:supplierId},function(json){
      if(json.ok){row.remove();if(String($('#supplier-id').val()||'0')===String(supplierId)){window.location=ccpBuildUrl({supplier_id:0, active_tab:'suppliers'});}}
      else{toast(json.message||'{{ text_ajax_error|e('js') }}');}
    });
  });
  function showResult(text){$('#queue-result').text(text);}
  function formatRowErrors(json){var list=(json&&$.isArray(json.row_errors))?json.row_errors:[];if(!list.length){return '';}var parts=[];$.each(list.slice(0,5),function(i,item){var id=item.new_id||item.review_id||'';var msg=item.message||'';parts.push((id?('ID '+id+': '):'')+msg);});if(list.length>5){parts.push('...');}return ' {{ text_error_details|e('js') }}: '+parts.join(' | ');}
  function formatEta(sec){sec=parseInt(sec||0,10);if(sec<=0){return '-';}var m=Math.floor(sec/60),s=sec%60,h=Math.floor(m/60);m=m%60;return (h>0?h+'h ':'')+m+'m '+s+'s';}
  function updateStats(stats){if(!stats){return;}if(parseInt(stats.stopped||0,10)>0){ccpAbortRequested=true;ccpMarkStopRequested(true);}$('#kpi-total').text(stats.total||0);$('#kpi-pending').text(stats.pending||0);$('#kpi-processing').text(stats.processing||0);$('#kpi-done').text(stats.done||0);$('#kpi-error').text(stats.error||0);$('#kpi-skipped').text(stats.skipped||0);$('#kpi-remaining').text(stats.remaining||0);$('#kpi-found-preview').text(stats.found_preview||0);$('#kpi-matched').text(stats.matched||0);$('#kpi-unmatched').text(stats.unmatched||0);$('#kpi-new-pending').text(stats.new_pending||0);$('#queue-link-preview').text(stats.found_preview||0);$('#queue-link-new').text(stats.new_pending||0);$('#kpi-eta').text(formatEta(stats.eta_seconds||0));$('#kpi-locked').text(stats.locked?((stats.lock_owner||'locked')):'0');$('#queue-last-url').text('{{ text_last_url }}: '+(stats.last_url||''));var pc=parseInt(stats.progress_percent||0,10);$('#queue-progress').css('width',pc+'%').text(pc+'%');}

  $('select[data-current]').each(function(){var current=$(this).attr('data-current');if(current){$(this).val(current);}});
  var activeTab='{{ active_tab|e('js') }}';
  if(ccpActiveSupplierId>0){ccpStoreActiveSupplier(ccpActiveSupplierId);}else{var storedSupplierId=ccpGetStoredSupplier();if(storedSupplierId>0 && !/[?&]supplier_id=/.test(window.location.search)){setTimeout(function(){reloadWithSupplier(storedSupplierId);},60);}}
  if(activeTab){var target='#tab-'+activeTab.replace(/^tab-/,'');var link=$('.ccp-tabs a[href="'+target+'"]');if(link.length){link.tab('show');}}
  $('.ccp-tabs a[data-toggle="tab"]').on('shown.bs.tab',function(e){var id=String($(e.target).attr('href')||'').replace(/^#tab-/,'');$('.ccp-active-tab-input').val(id);});
  var ccpAdminIndexUrl = '{{ admin_index_url|e('js') }}';
  var ccpUserToken = '{{ user_token|e('js') }}';
  function ccpBuildUrl(params){
    params=params||{};
    var explicitSupplier = Object.prototype.hasOwnProperty.call(params,'supplier_id');
    var base = (ccpAdminIndexUrl || 'index.php').replace(/&amp;/g,'&').split('?')[0];
    var current = new URL(window.location.href);
    var data = {};
    var keep = ['supplier_id','active_tab','review_page','review_limit','review_sort','review_order','review_text','review_status','review_type','review_change','new_page','new_limit','new_sort','new_order','new_text','new_status','queue_page','queue_limit','queue_sort','queue_order','queue_text','history_page','history_limit','history_sort','history_order','history_text','log_page','log_limit','log_sort','log_order','log_text'];
    $.each(keep,function(i,k){var v=current.searchParams.get(k);if(v!==null && v!=='' && v!=='0'){data[k]=v;}});
    if(!explicitSupplier && !data.supplier_id && ccpActiveSupplierId>0){data.supplier_id=ccpActiveSupplierId;}
    $.each(params,function(k,v){if(v===null||v===''||v===0||v==='0'){delete data[k];}else{data[k]=v;}});
    if(!explicitSupplier && !data.supplier_id && ccpActiveSupplierId>0){data.supplier_id=ccpActiveSupplierId;}
    var query=['route=extension/module/supplier_sync_parser_pro','user_token='+encodeURIComponent(ccpUserToken||'')];
    $.each(data,function(k,v){query.push(encodeURIComponent(k)+'='+encodeURIComponent(v));});
    return base+'?'+query.join('&');
  }
  function restoreCurrentControls(context){
    context=context||document;
    initPaginationBoxes(context);
    $(context).find('select[data-current]').each(function(){var current=$(this).attr('data-current');if(current){$(this).val(current);}});
    $(context).find('[data-toggle="tooltip"]').tooltip({container:'body',html:false});
  }
  function reloadWithSupplier(supplierId){
    supplierId=parseInt(supplierId||0,10)||0;
    ccpStoreActiveSupplier(supplierId);
    var active = String($('.ccp-tabs li.active a').attr('href') || '#tab-master').replace(/^#tab-/, '');
    var url = ccpBuildUrl({supplier_id:(supplierId && supplierId !== '0') ? supplierId : '', active_tab:active});
    setAjaxBusy(true);
    $.ajax({url:url,type:'get',dataType:'html',success:function(html){
      var parsed=$('<div/>').append($.parseHTML(html, document, true));
      var fresh=parsed.find('.ccp-ssp');
      if(fresh.length && $('.ccp-ssp').length){
        $('.ccp-ssp').html(fresh.html());
        ccpStoreActiveSupplier(supplierId);
        restoreCurrentControls($('.ccp-ssp'));
        var target='#tab-'+active;
        if($('.ccp-tabs a[href="'+target+'"]').length){$('.ccp-tabs a[href="'+target+'"]').tab('show');}
        history.pushState(null,'',url);
        
      } else {
        window.location.href=url;
      }
    },error:function(){window.location.href=url;},complete:function(){setAjaxBusy(false);}});
  }
  $(document).on('change','#ccp-active-supplier,.ccp-supplier-scope-select',function(){ reloadWithSupplier(String($(this).val() || '0')); });
  $(document).on('click','.ccp-tabs a[data-require-supplier="1"]',function(e){
    if (!ccpActiveSupplierId) {
      e.preventDefault();
      toast('{{ text_supplier_context_required|e('js') }}');
      $('.ccp-tabs a[href="#tab-master"]').tab('show');
      return false;
    }
  });
  var ccpFieldHelps={
    base_url:"{{ help_field_base_url|e('js') }}",
