  $(document).on('click','#btn-clear-logs',function(){if(!confirm('{{ button_clear_logs }}?')){return;}post('{{ ajax_clear_logs }}',{supplier_id:ccpGetActiveSupplierId()},function(json){showResult(json.message||'{{ text_done|e('js') }}');refreshActivePane();});});
