  $(document).on('click','.ccp-history-rollback',function(){
    if(!confirm('{{ confirm_rollback_price_stock|e('js') }}')){return;}
    var button=$(this);
    post('{{ ajax_rollback_history }}',{history_id:button.data('history-id'),supplier_id:button.data('supplier-id')},function(json){
      $('#history-result').text(json.message||'');
      if(json.ok){refreshActivePane();}
    });
  });
