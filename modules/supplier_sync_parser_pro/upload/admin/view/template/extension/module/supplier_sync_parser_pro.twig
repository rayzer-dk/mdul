{{ header }}{{ column_left }}
<div id="content" class="ccp-ssp-page">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid ccp-ssp">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    {% if not module_supplier_sync_parser_pro_status %}
    <div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-triangle"></i> {{ error_module_disabled }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}

    <div class="ccp-topbar">
      <div>
        <div class="ccp-meta">{{ text_author }} CodeCart PRO · v{{ version }} · {{ text_compatibility }} ocStore 3.0.4.1 · OpenCart 3.x · PHP 7.4–8.5</div>
      </div>
      <div class="ccp-top-actions">
        <select id="ccp-module-status-control" class="form-control ccp-module-status-control" aria-label="{{ entry_module_status }}"><option value="0" {{ not module_supplier_sync_parser_pro_status ? 'selected' : '' }}>{{ text_disabled }}</option><option value="1" {{ module_supplier_sync_parser_pro_status ? 'selected' : '' }}>{{ text_enabled }}</option></select>
        <button type="submit" form="form-settings" class="btn btn-primary btn-sm" id="ccp-module-status-save"><i class="fa fa-save"></i> {{ button_save_module }}</button>
      </div>
    </div>

    <div id="ccp-ajax-indicator" class="ccp-ajax-indicator"><i class="fa fa-spinner fa-spin"></i> {{ text_ajax_working }}</div>
    <div id="ccp-toast" class="ccp-toast"></div>

    <details class="ccp-workflow-card">
      <summary class="ccp-card-title"><i class="fa fa-sitemap"></i> {{ text_ui_workflow_title }}</summary>
      <div class="ccp-workflow-grid ccp-workflow-grid-6">
        <div class="ccp-flow-step"><b><i class="fa fa-truck"></i> {{ text_ui_step_supplier_title }}</b><span>{{ text_ui_step_supplier_desc }}</span></div>
        <div class="ccp-flow-step"><b><i class="fa fa-code"></i> {{ text_ui_step_rules_title }}</b><span>{{ text_ui_step_rules_desc }}</span></div>
        <div class="ccp-flow-step"><b><i class="fa fa-tasks"></i> {{ text_ui_step_queue_title }}</b><span>{{ text_ui_step_queue_desc }}</span></div>
        <div class="ccp-flow-step"><b><i class="fa fa-magic"></i> {{ text_ui_step_scan_title }}</b><span>{{ text_ui_step_scan_desc }}</span></div>
        <div class="ccp-flow-step"><b><i class="fa fa-cogs"></i> {{ text_ui_step_process_title }}</b><span>{{ text_ui_step_process_desc }}</span></div>
        <div class="ccp-flow-step"><b><i class="fa fa-check-square-o"></i> {{ text_ui_step_apply_title }}</b><span>{{ text_ui_step_apply_desc }}</span></div>
      </div>
      <div class="ccp-workflow-notes">
        <span><i class="fa fa-bolt"></i> {{ text_ui_ajax_status }}</span>
        <span><i class="fa fa-shield"></i> {{ text_ui_safe_note }}</span>
      </div>
    </details>

    <div class="alert alert-warning ccp-alert"><i class="fa fa-database"></i> {{ text_warning_backup }}</div>
    {% if module_supplier_sync_parser_pro_stop_queue %}
    <div class="alert alert-info ccp-alert"><i class="fa fa-pause-circle"></i> {{ text_queue_stop_active }}</div>
    {% endif %}

    <div class="ccp-supplier-context {{ supplier.supplier_id ? 'is-selected' : 'is-missing' }}">
      <div class="ccp-supplier-context-info">
        <div class="ccp-card-title"><i class="fa fa-user-circle"></i> {{ text_supplier_context_title }}</div>
        <details class="ccp-inline-help"><summary aria-label="{{ text_supplier_context_help }}"><i class="fa fa-question-circle" aria-hidden="true"></i></summary><div>{{ text_supplier_context_help }}</div></details>
      </div>
      <div class="ccp-supplier-context-control">
        <select id="ccp-active-supplier" class="form-control">
          <option value="0">{{ text_supplier_context_required }}</option>
          {% for item in suppliers %}
          <option value="{{ item.supplier_id }}" {{ supplier.supplier_id == item.supplier_id ? 'selected' : '' }}>{{ item.name }} #{{ item.supplier_id }}</option>
          {% endfor %}
        </select>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-body">
        <ul class="nav nav-tabs ccp-tabs">
          <li class="{{ active_tab == 'master' ? 'active' : '' }}"><a href="#tab-master" data-toggle="tab"><i class="fa fa-map-signs"></i> {{ tab_master|default('Мастер запуска') }}</a></li>
          <li class="{{ active_tab == 'suppliers' ? 'active' : '' }}"><a href="#tab-suppliers" data-toggle="tab"><i class="fa fa-truck"></i> {{ tab_suppliers }}</a></li>
          <li><a href="#tab-rules" data-toggle="tab" data-require-supplier="1"><i class="fa fa-code"></i> {{ tab_rules }}</a></li>
          <li><a href="#tab-queue" data-toggle="tab" data-require-supplier="1"><i class="fa fa-tasks"></i> {{ tab_queue }}</a></li>
          <li><a href="#tab-review" data-toggle="tab" data-require-supplier="1"><i class="fa fa-eye"></i> {{ tab_review }}</a></li>
          <li><a href="#tab-new" data-toggle="tab" data-require-supplier="1"><i class="fa fa-plus-circle"></i> {{ tab_new }}</a></li>
          <li><a href="#tab-mapping" data-toggle="tab" data-require-supplier="1"><i class="fa fa-link"></i> {{ tab_mapping }}</a></li>
          <li><a href="#tab-history" data-toggle="tab" data-require-supplier="1"><i class="fa fa-history"></i> {{ tab_history }}</a></li>
          <li><a href="#tab-logs" data-toggle="tab" data-require-supplier="1"><i class="fa fa-list"></i> {{ tab_logs }}</a></li>
          <li><a href="#tab-diagnostics" data-toggle="tab" data-require-supplier="1"><i class="fa fa-stethoscope"></i> {{ tab_diagnostics }}</a></li>
          <li><a href="#tab-settings" data-toggle="tab"><i class="fa fa-cog"></i> {{ tab_settings }}</a></li>
          <li><a href="#tab-about" data-toggle="tab"><i class="fa fa-info-circle"></i> {{ tab_about }}</a></li>
        </ul>

        <div class="tab-content ccp-tab-content">

          <div class="tab-pane {{ active_tab == 'master' ? 'active' : '' }}" id="tab-master">
            <div class="ccp-card ccp-commercial-master">
              <div class="ccp-card-title"><i class="fa fa-map-signs"></i> {{ text_master_title|default('Коммерческий мастер запуска') }}</div>
              <div class="ccp-note ccp-note-info"><i class="fa fa-shield"></i> {{ text_master_intro|default('Работайте как в коммерческих парсерах: сначала источник, затем правила, потом поиск ссылок, проверка карточек, предпросмотр и только после этого ручное применение выбранных строк.') }}</div>
              {% if not supplier.supplier_id %}
              <div class="ccp-master-create">
                <div><b><i class="fa fa-plus-circle"></i> {{ text_master_create_supplier_title|default('Начните с создания поставщика') }}</b><span>{{ text_master_create_supplier_help|default('Мастер не требует заранее выбранного поставщика. Сначала создайте поставщика, укажите домен, валюту, язык и источники, затем вернитесь в мастер для проверки правил и очереди.') }}</span></div>
                <a class="btn btn-primary btn-sm" href="#tab-suppliers" data-toggle="tab"><i class="fa fa-truck"></i> {{ button_master_create_supplier|default('Создать поставщика') }}</a>
              </div>
              {% else %}
              <div class="ccp-master-create is-ready">
                <div><b><i class="fa fa-check-circle"></i> {{ text_master_supplier_selected|default('Поставщик выбран') }}</b><span>{{ supplier.name }} #{{ supplier.supplier_id }}. {{ text_master_supplier_selected_help|default('Теперь можно проверять правила, искать ссылки товаров и запускать пакетную проверку.') }}</span></div>
                <a class="btn btn-default btn-sm" href="#tab-suppliers" data-toggle="tab"><i class="fa fa-pencil"></i> {{ button_master_edit_supplier|default('Открыть поставщика') }}</a>
              </div>
              {% endif %}
              <div class="ccp-master-grid">
                <div class="ccp-master-step {{ supplier.supplier_id ? 'is-ready' : '' }}"><b>1. {{ tab_suppliers }}</b><span>{{ text_master_supplier|default('Создайте поставщика, домен, валюту, язык и источники.') }}</span><a class="btn {{ supplier.supplier_id ? 'btn-default' : 'btn-primary' }} btn-xs" href="#tab-suppliers" data-toggle="tab">{{ supplier.supplier_id ? button_master_edit_supplier|default('Открыть поставщика') : button_master_create_supplier|default('Создать поставщика') }}</a></div>
                <div class="ccp-master-step {{ supplier.name_xpath and supplier.price_xpath ? 'is-ready' : '' }}"><b>2. {{ tab_rules }}</b><span>{{ text_master_rules|default('Проверьте одну реальную карточку товара и сохраните правила.') }}</span><a class="btn btn-default btn-xs" href="#tab-rules" data-toggle="tab">{{ tab_rules }}</a></div>
                <div class="ccp-master-step"><b>3. {{ text_master_find_links|default('Найти ссылки') }}</b><span>{{ text_master_find_links_help|default('Соберите URL товаров из категорий, домена или sitemap. Товары еще не обновляются.') }}</span><button type="button" class="btn btn-primary btn-xs" id="btn-master-find-links"><i class="fa fa-link"></i> {{ text_master_find_links|default('Найти ссылки') }}</button></div>
                <div class="ccp-master-step"><b>4. {{ text_master_check_sample|default('Проверить первые 10') }}</b><span>{{ text_master_check_sample_help|default('Сначала проверьте малую выборку, чтобы убедиться в цене, SKU, названии и фото.') }}</span><button type="button" class="btn btn-info btn-xs" id="btn-master-check-sample"><i class="fa fa-flask"></i> {{ text_master_check_sample|default('Проверить первые 10') }}</button></div>
                <div class="ccp-master-step"><b>5. {{ text_master_check_all|default('Проверить все') }}</b><span>{{ text_master_check_all_help|default('После успешной выборки запускайте пакетную проверку всех найденных товаров.') }}</span><button type="button" class="btn btn-success btn-xs" id="btn-master-check-all"><i class="fa fa-forward"></i> {{ text_master_check_all|default('Проверить все') }}</button></div>
                <div class="ccp-master-step"><b>6. {{ tab_review }}</b><span>{{ text_master_apply|default('Сравните товар поставщика и ваш товар, выберите строки и примените действие вручную.') }}</span><a class="btn btn-warning btn-xs" href="#tab-review" data-toggle="tab"><i class="fa fa-eye"></i> {{ tab_review }}</a></div>
              </div>
              <div class="ccp-master-status">
                <span>{{ text_master_queue|default('Очередь') }}: <b>{{ queue_stats.total|default(0) }}</b></span>
                <span>{{ tab_review }}: <b>{{ review_stats.total|default(0) }}</b></span>
                <span>{{ tab_new }}: <b>{{ new_stats.total|default(0) }}</b></span>
                <span>{{ text_master_remaining|default('Осталось') }}: <b>{{ queue_stats.remaining|default(queue_stats.pending|default(0)) }}</b></span>
              </div>
            </div>
          </div>

          <div class="tab-pane {{ active_tab == 'suppliers' ? 'active' : '' }}" id="tab-suppliers">
            <div class="row">
              <div class="col-sm-4">
                <details class="ccp-disclosure ccp-supplier-list">
                  <summary><i class="fa fa-truck"></i> {{ tab_suppliers }}</summary>
                  <div class="ccp-disclosure-body">
                  <div class="ccp-scroll ccp-list-scroll">
                    <table class="table table-condensed table-hover ccp-supplier-table">
                      <thead><tr><th>{{ column_supplier }}</th><th class="text-center">{{ text_status }}</th><th class="text-right"></th></tr></thead>
                      <tbody>
                        {% if suppliers %}
                        {% for item in suppliers %}
                        <tr data-supplier-row="{{ item.supplier_id }}" class="{{ supplier.supplier_id == item.supplier_id ? 'active' : '' }}">
                          <td><a href="{{ route_url }}&supplier_id={{ item.supplier_id }}">{{ item.name }}</a><div class="ccp-muted">#{{ item.supplier_id }}</div></td>
                          <td class="text-center"><button type="button" class="ccp-switch ccp-switch-mini ccp-supplier-row-switch {{ item.status ? 'is-on' : '' }}" data-supplier-id="{{ item.supplier_id }}" data-value="{{ item.status ? 1 : 0 }}" aria-pressed="{{ item.status ? 'true' : 'false' }}"><span class="ccp-switch-track"><span class="ccp-switch-thumb"></span></span><span class="ccp-switch-text ccp-supplier-list-status-text">{{ item.status ? text_enabled : text_disabled }}</span></button></td>
                          <td class="text-right"><button type="button" class="btn btn-danger btn-xs ccp-delete-supplier" data-supplier-id="{{ item.supplier_id }}" title="{{ button_delete|default('Delete') }}"><i class="fa fa-trash"></i></button></td>
                        </tr>
                        {% endfor %}
                        {% else %}
                        <tr><td colspan="3" class="text-center">{{ text_none }}</td></tr>
                        {% endif %}
                      </tbody>
                    </table>
                  </div>
                  <a class="btn btn-default btn-block" href="{{ route_url }}"><i class="fa fa-plus"></i> {{ button_add_supplier }}</a>
                  {% for preset in preset_urls %}<a class="btn btn-default btn-block" href="{{ preset.url }}"><i class="fa fa-file-text-o"></i> {{ preset.name }}</a>{% endfor %}
                  </div>
                </details>
              </div>
              <div class="col-sm-8">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-supplier" class="form-horizontal">
                  <input type="hidden" name="source_preset" value="{{ source_preset }}" />
                  <input type="hidden" name="save_supplier" value="1" />
                  <input type="hidden" name="active_tab" class="ccp-active-tab-input" value="{{ active_tab }}" />
                  <input type="hidden" name="supplier_id" id="supplier-id" value="{{ supplier.supplier_id }}" />
                  <div class="ccp-card">
                    <div class="ccp-card-title"><i class="fa fa-pencil"></i> {{ entry_supplier }}</div>
                    <details class="ccp-disclosure"><summary>{{ text_supplier_next_steps_title }}</summary><div class="ccp-disclosure-body">{{ text_supplier_next_steps_desc }}</div></details>
                    <div class="ccp-readiness-grid">
                      <div class="ccp-readiness {{ supplier.supplier_id ? 'is-ready' : 'is-missing' }}"><i class="fa fa-save"></i><b>{{ text_check_supplier_saved }}</b><span>{{ supplier.supplier_id ? text_ready : text_not_ready }}</span></div>
                      <div class="ccp-readiness {{ supplier.base_url ? 'is-ready' : 'is-missing' }}"><i class="fa fa-globe"></i><b>{{ text_check_base_url }}</b><span>{{ supplier.base_url ? text_ready : text_not_ready }}</span></div>
                      <div class="ccp-readiness {{ supplier.name_xpath and supplier.price_xpath ? 'is-ready' : 'is-missing' }}"><i class="fa fa-code"></i><b>{{ text_check_product_rules }}</b><span>{{ supplier.name_xpath and supplier.price_xpath ? text_ready : text_not_ready }}</span></div>
                      <div class="ccp-readiness {{ supplier.product_url_xpath or supplier.list_urls ? 'is-ready' : 'is-missing' }}"><i class="fa fa-list"></i><b>{{ text_check_queue_source }}</b><span>{{ supplier.product_url_xpath ? text_ready_category_scan : (supplier.list_urls ? text_ready_direct_urls : text_not_ready) }}</span></div>
                    </div>
                    <div class="ccp-subtitle"><i class="fa fa-database"></i> {{ text_source_block_title|default('1. Источники и базовые данные поставщика') }}</div>
                    <div class="row ccp-form-grid">
                      <input type="hidden" name="status" id="ccp-supplier-status-hidden" value="{{ supplier.supplier_id ? (supplier.status ? 1 : 0) : 1 }}" />
                      <div class="col-sm-8"><label>{{ entry_supplier_name }}</label><input type="text" name="name" value="{{ supplier.name }}" class="form-control" maxlength="255" /></div>
                      <div class="col-sm-4"><label>{{ entry_currency }}</label><select name="currency_code" class="form-control">{% for cur in currencies %}<option value="{{ cur.code }}" {{ supplier.currency_code == cur.code ? 'selected' : '' }}>{{ cur.code }}{% if cur.title %} - {{ cur.title }}{% endif %}{% if cur.code == base_currency %} ({{ text_base_currency }}){% endif %}</option>{% endfor %}</select></div>
                      <div class="col-sm-12"><label>{{ entry_base_url }}</label><input type="text" name="base_url" value="{{ supplier.base_url }}" class="form-control" /></div>
                      <div class="col-sm-4"><label>{{ entry_domain_policy }}</label><select name="domain_policy" class="form-control"><option value="strict_host" {{ supplier.domain_policy == 'strict_host' ? 'selected' : '' }}>{{ text_domain_policy_strict }}</option><option value="allow_subdomains" {{ supplier.domain_policy == 'allow_subdomains' ? 'selected' : '' }}>{{ text_domain_policy_subdomains }}</option><option value="allow_extra_hosts" {{ supplier.domain_policy == 'allow_extra_hosts' ? 'selected' : '' }}>{{ text_domain_policy_extra }}</option></select></div>
                      <div class="col-sm-8"><label>{{ entry_allowed_hosts }}</label><textarea name="allowed_hosts_text" rows="2" class="form-control">{{ allowed_hosts_text }}</textarea><div class="help-block">{{ help_domain_policy }}</div></div>
                      <div class="col-sm-12"><label>{{ entry_list_urls }}</label><textarea name="list_urls" rows="3" class="form-control">{{ supplier.list_urls }}</textarea><div class="help-block">{{ text_source_list_help|default('Одна ссылка в строке. Для категории используйте кнопку «Найти ссылки», для прямых карточек — режим прямых URL. Не смешивайте разные языки в одном запуске.') }}</div></div>
                      <div class="col-sm-4"><label>{{ entry_source_type }}</label><select name="source_type" class="form-control"><option value="html" {{ supplier.source_type == 'html' ? 'selected' : '' }}>{{ text_source_type_html }}</option><option value="feed" {{ supplier.source_type == 'feed' ? 'selected' : '' }}>{{ text_source_type_feed }}</option></select></div>
                      <div class="col-sm-12 ccp-feed-fields"><details class="ccp-disclosure"><summary><i class="fa fa-file-code-o"></i> {{ text_section_feed }}</summary><div class="ccp-disclosure-body"><div class="row">
                      <div class="col-sm-4"><label>{{ entry_feed_format }}</label><select name="feed_format" class="form-control"><option value="auto" {{ supplier.feed_format == 'auto' ? 'selected' : '' }}>Auto</option><option value="xml" {{ supplier.feed_format == 'xml' ? 'selected' : '' }}>XML/YML</option><option value="csv" {{ supplier.feed_format == 'csv' ? 'selected' : '' }}>CSV</option></select></div>
                      <div class="col-sm-4"><label>{{ entry_feed_file }}</label><input type="file" name="feed_file_upload" class="form-control" />{% if supplier.feed_file %}<div class="help-block">{{ text_feed_file_current }}: {{ supplier.feed_file }}</div>{% endif %}</div>
                      <div class="col-sm-12"><label>{{ entry_feed_url }}</label><input type="text" name="feed_url" value="{{ supplier.feed_url }}" class="form-control" /><div class="help-block">{{ text_feed_help }}</div></div>
                      <div class="col-sm-12"><div class="ccp-note ccp-note-info"><i class="fa fa-file-code-o"></i> {{ text_feed_mapping_help }}</div></div>
                      <div class="col-sm-12 ccp-feed-map-box">
                        <div class="ccp-note ccp-note-info"><b>{{ text_feed_mapping_title }}</b><br>{{ text_feed_mapping_intro }}</div>
                        <button type="button" id="btn-auto-detect-feed" class="btn btn-info btn-sm"><i class="fa fa-magic"></i> {{ button_auto_detect_feed }}</button>
                        <button type="button" id="btn-apply-feed-detected-to-form" class="btn btn-success btn-sm"><i class="fa fa-check"></i> {{ button_apply_feed_detected }}</button>
                        <span id="feed-auto-detect-save-result" class="ccp-muted"></span>
                        <div id="feed-auto-detect-result" class="ccp-auto-detect-result" style="margin-top:8px;"></div>
                      </div>
                      <div class="col-sm-3"><label>{{ entry_feed_item_path }}</label><input type="text" name="feed_item_path" value="{{ supplier.feed_item_path }}" class="form-control" placeholder="offer" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_url_path }}</label><input type="text" name="feed_url_path" value="{{ supplier.feed_url_path }}" class="form-control" placeholder="url" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_sku_path }}</label><input type="text" name="feed_sku_path" value="{{ supplier.feed_sku_path }}" class="form-control" placeholder="vendorCode / sku" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_name_path }}</label><input type="text" name="feed_name_path" value="{{ supplier.feed_name_path }}" class="form-control" placeholder="name" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_price_path }}</label><input type="text" name="feed_price_path" value="{{ supplier.feed_price_path }}" class="form-control" placeholder="price" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_stock_path }}</label><input type="text" name="feed_stock_path" value="{{ supplier.feed_stock_path }}" class="form-control" placeholder="available / stock" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_quantity_path }}</label><input type="text" name="feed_quantity_path" value="{{ supplier.feed_quantity_path }}" class="form-control" placeholder="quantity" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_category_path }}</label><input type="text" name="feed_category_path" value="{{ supplier.feed_category_path }}" class="form-control" placeholder="category / categoryId" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_description_path }}</label><input type="text" name="feed_description_path" value="{{ supplier.feed_description_path }}" class="form-control" placeholder="description" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_manufacturer_path }}</label><input type="text" name="feed_manufacturer_path" value="{{ supplier.feed_manufacturer_path }}" class="form-control" placeholder="vendor / brand" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_image_path }}</label><input type="text" name="feed_image_path" value="{{ supplier.feed_image_path }}" class="form-control" placeholder="picture / image" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_ean_path }}</label><input type="text" name="feed_ean_path" value="{{ supplier.feed_ean_path }}" class="form-control" placeholder="ean" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_upc_path }}</label><input type="text" name="feed_upc_path" value="{{ supplier.feed_upc_path }}" class="form-control" placeholder="upc" /></div>
                      <div class="col-sm-3"><label>{{ entry_feed_mpn_path }}</label><input type="text" name="feed_mpn_path" value="{{ supplier.feed_mpn_path }}" class="form-control" placeholder="mpn" /></div>
                      </div></div></details></div>
                      <div class="col-sm-6"><label>{{ entry_source_language }}</label><select name="source_language_code" class="form-control"><option value="">{{ text_none }}</option>{% for lang in languages %}<option value="{{ lang.code }}" {{ supplier.source_language_code == lang.code ? 'selected' : '' }}>{{ lang.name }} ({{ lang.code }})</option>{% endfor %}</select></div>
