{
  "name": "Sazagro",
  "status": 0,
  "base_url": "https://sazagro.com.ua",
  "source_type": "html",
  "list_urls": "https://sazagro.com.ua/ua/product_list",
  "product_url_xpath": "//a[contains(@href,'/p') and contains(@href,'.html')]",
  "product_url_attr": "href",
  "next_page_xpath": "//a[@rel='next'] | //a[contains(@class,'b-pager__link_type_next')]",
  "sku_xpath": "//*[@data-qaid='product_code']",
  "model_xpath": "//*[@data-qaid='product_code']",
  "name_xpath": "//h1",
  "price_xpath": "//*[@data-qaid='product_price']",
  "stock_xpath": "//*[@data-qaid='presence_data']",
  "category_xpath": "//*[@data-qaid='breadcrumbs']/@data-crumbs-path",
  "description_xpath": "//*[@data-qaid='product_description']",
  "manufacturer_xpath": "//tr[@data-qaid='attribute_item'][contains(td[1],'Виробник') or contains(td[1],'Производитель')]/td[2]",
  "image_xpath": "//img[contains(@class,'cs-pictures__img')]",
  "additional_images_xpath": "//img[contains(@class,'cs-pictures__img')]",
  "image_attr": "src",
  "attribute_row_xpath": "//tr[@data-qaid='attribute_item'][td[2]]",
  "attribute_name_xpath": "./td[1]",
  "attribute_value_xpath": "./td[2]",
  "currency_code": "UAH",
  "source_language_code": "uk-ua",
  "create_new": 1,
  "create_new_status": 0,
  "auto_apply_existing": 0,
  "auto_create_new": 0,
  "update_price": 1,
  "update_stock": 1,
  "import_attributes": 1,
  "import_additional_images": 1,
  "fill_all_languages": 0,
  "require_test_success": 1,
  "request_delay_ms": 1000,
  "settings": {
    "source_adapter": "prom",
    "in_stock_quantity": 100,
    "unknown_stock_policy": "keep",
    "update_stock_status": 1,
    "new_category_name": "Нові товари Sazagro"
  }
}
