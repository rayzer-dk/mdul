{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-catalog-import" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid catalog-import-pro">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <div class="alert alert-warning"><i class="fa fa-database"></i> {{ text_backup_warning }}</div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-cog"></i> {{ text_settings }}</h3></div>
      <div class="panel-body">
        <p class="text-muted">{{ text_dashboard_intro }}</p>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-catalog-import" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-status">{{ text_status }}</label>
            <div class="col-sm-9">
              <select name="module_scrapesmart_catalog_import_status" id="input-status" class="form-control">
                <option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-max-file">{{ text_max_file_size }}</label>
            <div class="col-sm-9"><input type="number" min="1" max="500" name="module_scrapesmart_catalog_import_max_file_size_mb" value="{{ max_file_size_mb }}" id="input-max-file" class="form-control"></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-max-image">{{ text_max_image_size }}</label>
            <div class="col-sm-9"><input type="number" min="1" max="50" name="module_scrapesmart_catalog_import_max_image_size_mb" value="{{ max_image_size_mb }}" id="input-max-image" class="form-control"></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-retention">{{ text_retention_days }}</label>
            <div class="col-sm-9"><input type="number" min="1" max="3650" name="module_scrapesmart_catalog_import_retention_days" value="{{ retention_days }}" id="input-retention" class="form-control"></div>
          </div>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-exchange"></i> {{ text_modules }}</h3></div>
      <div class="panel-body">
        <div class="row module-grid">
          <div class="col-sm-6 col-lg-3"><div class="module-card"><i class="fa fa-cubes"></i><h4>{{ text_product }}</h4><p>{{ text_product_help }}</p><a href="{{ product_url }}" class="btn btn-primary btn-sm">{{ button_open }}</a></div></div>
          <div class="col-sm-6 col-lg-3"><div class="module-card"><i class="fa fa-sitemap"></i><h4>{{ text_category }}</h4><p>{{ text_category_help }}</p><a href="{{ category_url }}" class="btn btn-primary btn-sm">{{ button_open }}</a></div></div>
          <div class="col-sm-6 col-lg-3"><div class="module-card"><i class="fa fa-industry"></i><h4>{{ text_manufacturer }}</h4><p>{{ text_manufacturer_help }}</p><a href="{{ manufacturer_url }}" class="btn btn-primary btn-sm">{{ button_open }}</a></div></div>
          <div class="col-sm-6 col-lg-3"><div class="module-card"><i class="fa fa-list-alt"></i><h4>{{ text_option }}</h4><p>{{ text_option_help }}</p><a href="{{ option_url }}" class="btn btn-primary btn-sm">{{ button_open }}</a></div></div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-7">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-trash-o"></i> {{ text_cleanup }}</h3></div>
          <div class="panel-body"><p>{{ text_cleanup_help }}</p><form action="{{ cleanup_url }}" method="post" onsubmit="return confirm('{{ text_cleanup_help|e('js') }}');"><button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> {{ button_cleanup }}</button></form></div>
        </div>
      </div>
      <div class="col-md-5">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-info-circle"></i> {{ text_about }}</h3></div>
          <div class="panel-body about-grid">
            <div><strong>{{ text_version }}:</strong> {{ version }}</div>
            <div><strong>{{ text_author }}:</strong> <a href="{{ author_url }}" target="_blank" rel="noopener noreferrer">{{ author }}</a></div>
            <div><strong>{{ text_compatibility }}:</strong> {{ text_compatibility_value }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
.catalog-import-pro .panel{border-radius:5px}.catalog-import-pro .panel-heading{background:#f8fafc}.catalog-import-pro .module-grid>[class*="col-"]{margin-bottom:15px}.catalog-import-pro .module-card{height:100%;min-height:190px;padding:20px;border:1px solid #dce3ea;border-radius:5px;background:#fff;position:relative}.catalog-import-pro .module-card>i{font-size:28px;color:#1e91cf}.catalog-import-pro .module-card h4{margin:12px 0 8px}.catalog-import-pro .module-card p{min-height:58px;color:#667}.catalog-import-pro .form-control{max-width:520px}.catalog-import-pro .about-grid>div{margin-bottom:8px}
</style>
{{ footer }}
