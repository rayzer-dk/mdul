	function nixRandomHex(length) {
		var chars = 'abcdef0123456789';
		var value = '';
		if (window.crypto && window.crypto.getRandomValues) {
			var bytes = new Uint8Array(length);
			window.crypto.getRandomValues(bytes);
			for (var i = 0; i < length; i++) { value += chars[bytes[i] % chars.length]; }
		} else {
			for (var j = 0; j < length; j++) { value += chars[Math.floor(Math.random() * chars.length)]; }
		}
		return value;
	}

	function nixRefreshCronFields() {
		var token = $('#input-cron-token').val() || '';
		var command = $('#input-cron-command').val() || '';
		var url = $('#input-cron-url').val() || '';
		if (command.indexOf('token=') !== -1) {
			$('#input-cron-command').val(command.replace(/token=.*/, 'token=' + token));
		}
		if (url.indexOf('token=') !== -1) {
			$('#input-cron-url').val(url.replace(/token=.*/, 'token=' + encodeURIComponent(token)));
		}
	}

