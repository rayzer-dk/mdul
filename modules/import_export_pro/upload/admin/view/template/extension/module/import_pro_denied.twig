{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel|replace({'&amp;':'&'})|e('html_attr') }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title_html|raw }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href|replace({'&amp;':'&'})|e('html_attr') }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid importpro-page">
    <style>
      .importpro-page .ip-card{border:1px solid #dfe5ec;border-radius:8px;background:#fff;margin-bottom:16px;box-shadow:0 1px 4px rgba(15,23,42,.04)}
      .importpro-page .ip-body{padding:18px}.importpro-page .ip-title{margin:0 0 8px;font-size:16px;font-weight:700;color:#0f172a}.importpro-page .ip-title .fa{color:#b42318;margin-right:6px}.importpro-page .ip-help{color:#667085;font-size:13px;line-height:1.45}
    </style>
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    <div class="ip-card"><div class="ip-body">
      <h3 class="ip-title"><i class="fa fa-lock"></i> {{ text_access_denied_title }}</h3>
      <div class="ip-help">{{ text_access_denied_help }}</div>
    </div></div>
  </div>
</div>
{{ footer }}
