var safeBatchId='';
var safeResultPage=1;
var safeResultPages=1;
var safeLoopActive=false;
var safeStopRequested=false;
var safeBatchStorageKey='import_export_pro_safe_batch_v366';

function safePersistBatch(){
  if(!safeBatchId)return;
  try{localStorage.setItem(safeBatchStorageKey,JSON.stringify({batch_id:safeBatchId,profile_id:getCurrentProfileId(),saved_at:Date.now()}));}catch(e){}
}
function safeForgetBatch(){
  try{localStorage.removeItem(safeBatchStorageKey);}catch(e){}
}
function safeRestoreBatch(){
  var saved=null;
  try{saved=JSON.parse(localStorage.getItem(safeBatchStorageKey)||'null');}catch(e){saved=null;}
  if(!saved||!saved.batch_id)return;
  safeBatchId=String(saved.batch_id);$('#safe-batch-id').val(safeBatchId);$('#import-progress-panel').show();$('a[href="#tab-run"]').tab('show');
  safeGetSummary(function(summary){safeLoadResults(1);});
}

function safePost(url,data,success){
  $.post(url,data,function(json){
    if(json&&json.error){safeLoopActive=false;$('#import-result').html('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> '+escapeHtml(json.error)+'</div>');return;}
    success((json&&json.result)||{});
  },'json').fail(function(xhr){safeLoopActive=false;if(showAjaxLoginError(xhr))return;$('#import-result').html('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ text_js_import_failed|e('js') }}</div>');});
}
function safeCounts(summary){return (summary&&summary.counts)||{};}
function safeUpdateSummary(summary){
  var c=safeCounts(summary), total=parseInt((summary.batch&&summary.batch.total_rows)||0), processed=0;
  ['created','updated','skipped','deleted','error','review','warning','dry_run'].forEach(function(k){processed+=parseInt(c[k]||0);});
  var success=parseInt(c.created||0)+parseInt(c.updated||0)+parseInt(c.deleted||0)+parseInt(c.review||0);
  var remaining=parseInt(c.pending||0)+parseInt(c.processing||0);
  var pct=total>0?Math.min(100,Math.round((processed/total)*100)):0;
  $('#import-progress-total').text(total);$('#import-progress-processed').text(processed);$('#import-progress-success').text(success);$('#import-progress-created').text(c.created||0);$('#import-progress-updated').text(c.updated||0);$('#import-progress-skipped').text(c.skipped||0);$('#import-progress-errors').text(c.error||0);$('#import-progress-remaining').text(remaining);$('#import-progress-percent').text(pct+'%');$('#import-progress-bar').css('width',pct+'%');
  var st=(summary.batch&&summary.batch.status)||'';
  var title=st==='review'?'{{ text_queue_review|e('js') }}':(st==='finished'?'{{ text_queue_finished|e('js') }}':(st==='preparing'?'{{ text_queue_preparing|e('js') }}':'{{ text_queue_processing|e('js') }}'));
  $('#import-progress-title').text(title);
  $('#button-import').prop('disabled',!(st==='review'&&parseInt(c.selected||0)>0));
  $('#button-retry-errors').prop('disabled',parseInt(c.error||0)===0);
  $('#button-recover-queue,#button-download-report').prop('disabled',!safeBatchId);
  $('#safe-review-panel').toggle(!!safeBatchId);
  safePersistBatch();
}
function safeGetSummary(next){
  if(!safeBatchId)return;
  safePost(safeSummaryUrl,{batch_id:safeBatchId},function(summary){safeUpdateSummary(summary);if(next)next(summary);});
}
function safeStart(mode){
  mode=mode||$('[name="run_mode"]').val()||'full';
  $('[name="run_mode"]').val(mode);
  ensureSaved(function(){
    var profileId=getCurrentProfileId(); if(!profileId){alert('{{ error_profile|e('js') }}');return;}
    safeStopRequested=false;safeLoopActive=true;resetImportProgress();$('#button-stop-import').prop('disabled',false);$('a[href="#tab-run"]').tab('show');
    $('#import-result').html('<div class="alert alert-info"><i class="fa fa-spinner fa-spin"></i> {{ text_queue_preparing }}</div>');
    safePost(safeStartUrl,{profile_id:profileId,run_mode:mode},function(r){safeBatchId=r.batch_id||'';$('#safe-batch-id').val(safeBatchId);safePersistBatch();safeResultPage=1;safePrepareLoop();});
  });
}
function safePrepareLoop(){
  if(!safeLoopActive||safeStopRequested||!safeBatchId)return;
  safePost(safePrepareUrl,{batch_id:safeBatchId,limit:250},function(r){safeGetSummary(function(){if(r.prepare_complete||r.finished){safeProcessLoop();}else{setTimeout(safePrepareLoop,120);}});});
}
function safeProcessLoop(){
  if(!safeLoopActive||safeStopRequested||!safeBatchId)return;
  safePost(safeProcessUrl,{batch_id:safeBatchId,limit:20},function(){safeGetSummary(function(summary){var c=safeCounts(summary);if(parseInt(c.pending||0)+parseInt(c.processing||0)>0){setTimeout(safeProcessLoop,120);}else{safeLoopActive=false;safeLoadResults(1);}});});
}
function safeRenderResults(r){
