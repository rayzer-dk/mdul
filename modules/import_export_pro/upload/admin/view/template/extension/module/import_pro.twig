function autoSuggestTarget(header){
  var h=(header||'').toLowerCase().trim();
  if(/^(product_id|product.?id)$/.test(h))return 'product_id';
  if(/^(@?id|offer.?id|external.?product.?id)$/.test(h))return 'external_product_id';
  if(/supplier.?quantity|supplier.?stock|остат.*постав|залиш.*постач/.test(h))return 'supplier_quantity';
  if(/supplier.?price|закуп|purchase|base.?price/.test(h))return 'supplier_price';
  if(/additional.?images?|extra.?images?|gallery|галере|додатков.*зображ|дополн.*изображ/.test(h))return 'additional_images';
  if(/main.?category.?id|головн.*категор.*id|главн.*категор.*id/.test(h))return 'main_category_id';
  if(/category.?ids|categories.?ids|category_id_list/.test(h))return 'category_ids';
  if(/external.?parent.?category.?id|parent.?external.?category.?id/.test(h))return 'external_parent_category_id';
  if(/external.?category.?id/.test(h))return 'external_category_id';
  if(/^category.?id$/.test(h))return 'category_ids';
  if(/supplier.?sku|supplier.?code|артикул.*постав|код.*постав|артикул.*постач|код.*постач/.test(h))return 'supplier_sku';
  if(/model|артикул|код.?товар|vendor.?code/.test(h))return 'model';
  if(/sku/.test(h))return 'sku';
  if(/ean/.test(h))return 'ean';
  if(/upc/.test(h))return 'upc';
  if(/jan/.test(h))return 'jan';
  if(/isbn/.test(h))return 'isbn';
  if(/mpn/.test(h))return 'mpn';
  if(/price|цін|цена|cena|cost/.test(h))return 'price';
  if(/points|балл|бонус/.test(h))return 'points';
  if(/stock.?status/.test(h))return 'stock_status_id';
  if(/qty|quantity|кільк|колич|залиш|остат|stock/.test(h))return 'quantity';
  if(/manufacturer.?id|brand.?id/.test(h))return 'manufacturer_id';
  if(/manufacturer|brand|виробник|производитель|бренд/.test(h))return 'manufacturer';
  if(/image|photo|зображ|картин|фото/.test(h))return 'image';
  if(/categor|категор/.test(h))return 'categories';
  if(/attribute|характер/.test(h))return 'attributes';
  if(/discount/.test(h))return 'discounts';
  if(/special|акци|акцi|знижк|скидк/.test(h))return 'specials';
  if(/reward/.test(h))return 'rewards';
  if(/recurring|subscription/.test(h))return 'recurring';
  if(/option|опци|опці/.test(h))return 'options';
  if(/store.?ids?/.test(h))return 'store_ids';
  if(/filter.?ids?/.test(h))return 'filter_ids';
  if(/download.?ids?/.test(h))return 'download_ids';
  if(/related.?article/.test(h))return 'related_article_ids';
  if(/related.?product/.test(h))return 'related_product_ids';
  if(/layout/.test(h))return 'layouts';
  if(/noindex/.test(h))return 'noindex';
  if(/^tag(s)?$|тег/.test(h))return 'tag:'+importDefaultLang;
  if(/url|link|посилан|ссылк|seo.?url|keyword|slug/.test(h))return 'product_url';
  if(/meta.?title|seo.?title/.test(h))return 'meta_title:'+importDefaultLang;
  if(/meta.?description|seo.?description/.test(h))return 'meta_description:'+importDefaultLang;
  if(/meta.?keyword/.test(h))return 'meta_keywords:'+importDefaultLang;
  if(/meta.?h1|^h1$/.test(h))return 'meta_h1:'+importDefaultLang;
  if(/description|опис/.test(h))return 'description:'+importDefaultLang;
  if(/name|назва|название|title/.test(h))return 'name:'+importDefaultLang;
  return '';
}
function normalizePreviewValue(value){if(value===undefined||value===null)return '';value=String(value).replace(/\s+/g,' ').trim();return value.length>180?value.substr(0,180)+'...':value;}
function collectFieldSamples(rows,header){var out=[],seen={};(rows||[]).forEach(function(row){var value=normalizePreviewValue(row&&row[header]!==undefined?row[header]:'');if(!value||seen[value])return;seen[value]=1;out.push(value);});return out.slice(0,5);}
function detectPreviewType(samples){var nonEmpty=(samples||[]).filter(function(v){return v!=='';});if(!nonEmpty.length)return '{{ text_field_type_empty|e('js') }}';var numeric=0,url=0,image=0,longText=0,date=0;nonEmpty.forEach(function(v){var t=String(v).trim();if(/^-?\d+([\.,]\d+)?$/.test(t))numeric++;if(/^https?:\/\//i.test(t))url++;if(/\.(jpg|jpeg|png|gif|webp|avif)(\?|$)/i.test(t))image++;if(t.length>90||/<[a-z][\s\S]*>/i.test(t))longText++;if(/^\d{4}-\d{2}-\d{2}/.test(t))date++;});if(image)return '{{ text_field_type_image|e('js') }}';if(url)return '{{ text_field_type_url|e('js') }}';if(numeric===nonEmpty.length)return '{{ text_field_type_number|e('js') }}';if(date)return '{{ text_field_type_date|e('js') }}';if(longText)return '{{ text_field_type_text_long|e('js') }}';return '{{ text_field_type_text_short|e('js') }}';}
function mappingWarningForTarget(target,typeLabel){if(!target)return '';var numericTargets=['price','quantity','minimum','status','manufacturer_id','main_category_id','product_id','shipping','tax_class_id','weight','length','width','height','sort_order','supplier_price','supplier_quantity'];var textTargets=['name','description','meta_title','meta_description','meta_h1','meta_keywords','manufacturer','categories','attributes'];var baseTarget=String(target).split(':')[0];if(numericTargets.indexOf(baseTarget)>=0 && typeLabel.indexOf('{{ text_field_type_number|e('js') }}')<0){return '{{ text_mapping_warning_numeric|e('js') }}';}if(textTargets.indexOf(baseTarget)>=0 && typeLabel.indexOf('{{ text_field_type_number|e('js') }}')>=0){return '{{ text_mapping_warning_text|e('js') }}';}return '';}
function refreshMappingWarnings(){ $('#mapping-builder-table tbody tr').each(function(){var type=$(this).data('type')||'';var target=$(this).find('select').val()||'';var msg=mappingWarningForTarget(target,type);var box=$(this).find('.mapping-target-warning');if(msg){box.html('<i class="fa fa-exclamation-triangle"></i> '+escapeHtml(msg)).show();}else{box.hide().empty();}}); }
function renderMappingBuilder(headers,sampleRow,rows){var tbody=$('#mapping-builder-table tbody');tbody.empty();var existing=invertFieldMap(parseFieldMapJson());headers.forEach(function(header){var current=existing[header]||autoSuggestTarget(header);var opts=importTargetFields.map(function(it){return '<option value="'+escapeHtml(it.value)+'" '+(current===it.value?'selected':'')+'>'+escapeHtml(it.label)+'</option>';}).join('');var samples=collectFieldSamples(rows,header);if(!samples.length&&sampleRow&&sampleRow[header]!==undefined){samples=[normalizePreviewValue(sampleRow[header])];}var typeLabel=detectPreviewType(samples);var samplesHtml=samples.length?samples.map(function(sample){return '<span class="mapping-sample-chip" title="'+escapeHtml(sample)+'">'+escapeHtml(sample)+'</span>';}).join(''):'<span class="text-muted">—</span>';tbody.append('<tr data-source="'+escapeHtml(header)+'" data-type="'+escapeHtml(typeLabel)+'"><td><strong>'+escapeHtml(header)+'</strong></td><td><div class="mapping-samples">'+samplesHtml+'</div><div class="mapping-type-badge">'+escapeHtml(typeLabel)+'</div></td><td><select class="form-control mapping-target">'+opts+'</select><div class="mapping-target-warning"></div></td></tr>');});$('#mapping-builder-status').removeClass('alert-warning alert-danger').addClass('alert-success').html('<i class="fa fa-check-circle"></i> {{ text_mapping_detected|e('js') }}: '+headers.length);$('#mapping-builder-table-wrap').show();refreshMappingWarnings();syncFieldMapFromBuilder();}

