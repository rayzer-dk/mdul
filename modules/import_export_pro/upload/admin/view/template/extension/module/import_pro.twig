function safeApply(){if(!safeBatchId||!confirm('{{ text_js_confirm_import|e('js') }}'))return;safePost(safeApplyUrl,{batch_id:safeBatchId},function(r){if(!parseInt(r.selected||0)){alert('{{ error_safe_apply_confirm|e('js') }}');return;}safeLoopActive=true;safeStopRequested=false;$('#button-stop-import').prop('disabled',false);safeProcessLoop();});}
function safeRetry(){if(!safeBatchId)return;safePost(safeRetryUrl,{batch_id:safeBatchId},function(){safeLoopActive=true;safeStopRequested=false;safeProcessLoop();});}
function safeCancel(){if(!safeBatchId)return;safeStopRequested=true;safePost(safeCancelUrl,{batch_id:safeBatchId},function(){safeLoopActive=false;safeGetSummary(function(){safeLoadResults(safeResultPage);});});}


