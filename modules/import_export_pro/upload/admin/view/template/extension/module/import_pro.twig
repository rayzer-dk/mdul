function detectFields(){if(!syncRawMapToHidden()){return;}$('#mapping-builder-status').removeClass('alert-success alert-danger').addClass('alert-warning').html('<i class="fa fa-spinner fa-spin"></i> ...');$.post(detectFieldsUrl,getProfilePayload(),function(json){if(json.error){$('#mapping-builder-status').removeClass('alert-success').addClass('alert-danger').html('<i class="fa fa-exclamation-circle"></i> '+escapeHtml(json.error));return;}renderMappingBuilder(json.headers||[],json.sample_row||{},json.rows||[]);},'json').fail(function(xhr){if(showAjaxLoginError(xhr))return;$('#mapping-builder-status').removeClass('alert-success').addClass('alert-danger').html('<i class="fa fa-exclamation-circle"></i> {{ text_js_detect_failed|e('js') }}');});}
