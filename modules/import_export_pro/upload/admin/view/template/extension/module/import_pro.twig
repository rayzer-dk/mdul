{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ update_url|replace({'&amp;':'&'})|e('html_attr') }}" target="_blank" rel="noopener" data-toggle="tooltip" title="{{ button_upgrade_module }}" class="btn btn-warning"><i class="fa fa-download"></i></a>
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel|replace({'&amp;':'&'})|e('html_attr') }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title_html|raw }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href|replace({'&amp;':'&'})|e('html_attr') }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid importpro-page">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}

    <style>
      .importpro-page .ip-card{border:1px solid #dfe5ec;border-radius:8px;background:#fff;margin-bottom:16px;box-shadow:0 1px 4px rgba(15,23,42,.04)}
      .importpro-page .ip-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-bottom:1px solid #e8edf3;background:linear-gradient(180deg,#fff 0,#f8fbff 100%);border-radius:8px 8px 0 0;flex-wrap:wrap}
      .importpro-page .ip-title{margin:0;font-size:15px;font-weight:700;color:#0f172a}.importpro-page .ip-title .fa{color:#0057b7;margin-right:6px}
      .importpro-page .ip-body{padding:14px}.importpro-page .ip-muted{color:#667085;font-size:12px;line-height:1.45}.importpro-page .ip-help{color:#667085;font-size:12px;line-height:1.4;margin-top:4px}.importpro-page .ip-help .fa{margin-right:3px;color:#0057b7}
      .importpro-page .ip-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:12px}
      .importpro-page .ip-badge{display:inline-block;border-radius:12px;padding:2px 9px;font-size:11px;font-weight:700;background:#ffd700;color:#0057b7}
      .importpro-page .ip-pill{display:inline-block;border-radius:12px;padding:3px 9px;font-size:11px;background:#eef6ff;color:#0057b7;border:1px solid #cfe2ff}
      .importpro-page .ip-pill .fa{margin-right:3px}
      .importpro-page .nav-tabs{margin-bottom:14px;border-bottom:1px solid #dfe5ec}
      .importpro-page .nav-tabs>li>a{font-weight:600;color:#334155;padding:10px 14px}
      .importpro-page .nav-tabs>li.active>a,.importpro-page .nav-tabs>li.active>a:hover{color:#0057b7;border-color:#dfe5ec #dfe5ec transparent}
      .importpro-page .nav-tabs .fa{margin-right:5px;color:#0057b7}
      .importpro-page .ip-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.importpro-page .ip-grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.importpro-page .ip-grid-4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
      .importpro-page .ip-box{border:1px solid #e8edf3;border-radius:8px;background:#fbfdff;padding:12px}.importpro-page .ip-box h4{margin:0 0 10px;font-size:14px;color:#0057b7;font-weight:700}.importpro-page .ip-box h4 .fa{margin-right:5px}
      .importpro-page .form-group{margin-left:0;margin-right:0;margin-bottom:10px}.importpro-page .control-label{font-weight:600;color:#334155;display:block;margin-bottom:4px}
      .importpro-page .control-label .fa{margin-right:4px;color:#0057b7;font-size:11px}
      .importpro-page .checkbox,.importpro-page .checkbox-inline{margin-top:0;margin-bottom:8px}.importpro-page .btn .fa{margin-right:4px}
      .importpro-page .ip-profile-list{display:flex;flex-wrap:wrap;gap:8px}
      .importpro-page .ip-profile{min-width:220px;max-width:320px;border:1px solid #dfe5ec;border-radius:8px;background:#fff;padding:10px 12px;cursor:pointer;transition:.15s ease}
      .importpro-page .ip-profile:hover{border-color:#9ec5fe;background:#f8fbff}.importpro-page .ip-profile.active-row{border-color:#0057b7;background:#eef6ff}
      .importpro-page .ip-profile-title{font-weight:700;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.importpro-page .ip-profile-meta{font-size:12px;color:#667085;margin-top:3px}
      .importpro-page .ip-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-top:12px;padding-top:12px;border-top:1px solid #e8edf3}
      .importpro-page .ip-result{margin-top:14px}.importpro-page .ip-scroll{overflow:auto}
      .importpro-page .ip-table-wide{min-width:1100px}.importpro-page .ip-table-wide th,.importpro-page .ip-table-wide td{white-space:normal;word-break:break-word;vertical-align:top}
      .importpro-page .ip-code{font-family:Consolas,Monaco,monospace;min-height:130px}.importpro-page .ip-hidden{display:none}
      .importpro-page .mapping-sample{max-width:420px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#667085}.importpro-page .mapping-target{min-width:240px}
      .importpro-page .export-field-groups{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
      .importpro-page .export-field-list{display:flex;flex-direction:column;gap:5px;max-height:190px;overflow:auto}
      .importpro-page .export-presets{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
      .importpro-page .ip-sticky-actions{position:sticky;bottom:0;z-index:20;background:#fff;border:1px solid #dfe5ec;border-radius:8px;padding:10px;box-shadow:0 -2px 10px rgba(15,23,42,.07)}
      .importpro-page .ip-cron-fields{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;font-family:Consolas,Monaco,monospace;font-size:13px;background:#fff;border:1px solid #e8edf3;border-radius:6px;padding:8px;margin:6px 0}
      .importpro-page .ip-cron-fields div{padding:4px 6px;background:#f8fbff;border-radius:4px;text-align:center}
      .importpro-page .ip-cron-fields strong{display:block;font-size:11px;color:#667085;font-weight:600;margin-bottom:2px}
      .importpro-page .ip-about-box{background:#fff;border:1px solid #e8edf3;border-radius:8px;padding:14px;margin-bottom:12px}
      .importpro-page .ip-about-box h4{color:#0057b7;margin:0 0 8px;font-size:14px;font-weight:700}
      .importpro-page .ip-about-box h4 .fa{margin-right:6px}
      .importpro-page .ip-about-box p{margin:0 0 6px;color:#334155;line-height:1.5}
      .importpro-page .ip-about-box ul{margin:6px 0 0 18px;color:#334155;line-height:1.5}
      .importpro-page .ip-about-box ul li{margin-bottom:3px}
      .importpro-page .ip-about-box ul li .fa{color:#198754;margin-right:6px;width:14px}
      .importpro-page .ip-version-pill{display:inline-block;background:#0057b7;color:#fff;padding:2px 9px;border-radius:12px;font-size:11px;font-weight:700;margin-left:6px}
      .importpro-page .ip-status-ok{color:#198754;font-weight:700}.importpro-page .ip-status-warn{color:#b7791f;font-weight:700}.importpro-page .ip-status-error{color:#dc3545;font-weight:700}.importpro-page .ip-author-link{font-weight:700;color:#0057b7}.importpro-page .ip-setting-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-top:12px}.importpro-page .mapping-samples{display:flex;flex-wrap:wrap;gap:4px;max-width:520px}.importpro-page .mapping-sample-chip{display:inline-block;max-width:155px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#f8fbff;border:1px solid #dfe7f1;border-radius:12px;padding:3px 8px;font-size:12px;color:#344054}.importpro-page .mapping-type-badge{display:inline-block;margin-top:5px;background:#eef4ff;color:#0057b7;border-radius:12px;padding:2px 8px;font-size:11px;font-weight:700}.importpro-page .mapping-target-warning{display:none;margin-top:5px;color:#b42318;font-size:12px}.importpro-page .mapping-target-warning .fa{color:#b42318}
      .importpro-page .ip-progress-panel{display:none;margin:12px 0;padding:12px;border:1px solid #d9e4f2;border-radius:10px;background:#f8fbff}.importpro-page .ip-progress-title{font-weight:700;color:#0f3660;margin-bottom:8px}.importpro-page .ip-progressbar{height:18px;background:#e9eef5;border-radius:999px;overflow:hidden}.importpro-page .ip-progressbar span{display:block;height:18px;width:0;background:#2b80d7;transition:width .2s ease}.importpro-page .ip-progress-meta{display:flex;gap:12px;flex-wrap:wrap;margin-top:8px;color:#334155;font-size:12px}.importpro-page .ip-progress-meta b{color:#0f3660}.importpro-page .ip-progress-actions{margin-top:10px}
      @media(max-width:1199px){.importpro-page .ip-grid,.importpro-page .ip-grid-3,.importpro-page .ip-grid-4,.importpro-page .export-field-groups{grid-template-columns:1fr}.importpro-page .ip-sticky-actions{position:static}.importpro-page .ip-cron-fields{grid-template-columns:repeat(2,1fr)}}
    </style>

    <div class="ip-toolbar">
      <span class="ip-badge">PRO</span>
      <span class="ip-pill"><i class="fa fa-cube"></i> ocStore/OpenCart 3.x</span>
      <span class="ip-pill"><i class="fa fa-code"></i> PHP 7.4–8.5</span>
      <span class="ip-pill"><i class="fa fa-shield"></i> OCMOD-only</span>
      <span class="ip-pill"><i class="fa fa-tag"></i> v{{ module_version|e }}</span>
      <span class="ip-pill"><i class="fa fa-user"></i> {{ text_author }}: <a class="ip-author-link" href="{{ author_url|replace({'&amp;':'&'})|e('html_attr') }}" target="_blank" rel="noopener">{{ author_name|e }}</a></span>
    </div>

    <div class="alert alert-warning"><i class="fa fa-shield"></i> {{ text_atomic_import_notice }}</div>

    <ul class="nav nav-tabs" id="importpro-main-tabs">
      <li class="active"><a href="#tab-settings" data-toggle="tab"><i class="fa fa-cog"></i> {{ tab_settings }}</a></li>
      <li><a href="#tab-profile" data-toggle="tab"><i class="fa fa-list-alt"></i> {{ tab_profile }}</a></li>
      <li><a href="#tab-fields" data-toggle="tab"><i class="fa fa-random"></i> {{ tab_fields }}</a></li>
      <li><a href="#tab-rules" data-toggle="tab"><i class="fa fa-filter"></i> {{ tab_rules }}</a></li>
      <li><a href="#tab-run" data-toggle="tab"><i class="fa fa-flask"></i> {{ tab_run }}</a></li>
      <li><a href="#tab-export" data-toggle="tab"><i class="fa fa-download"></i> {{ tab_export }}</a></li>
      <li><a href="#tab-logs" data-toggle="tab"><i class="fa fa-history"></i> {{ tab_logs }}</a></li>
      <li><a href="#tab-diagnostics" data-toggle="tab"><i class="fa fa-stethoscope"></i> {{ tab_diagnostics }}</a></li>
      <li><a href="#tab-cron" data-toggle="tab"><i class="fa fa-clock-o"></i> {{ tab_cron }}</a></li>
      <li><a href="#tab-about" data-toggle="tab"><i class="fa fa-info-circle"></i> {{ tab_about }}</a></li>
    </ul>

    <div class="tab-content">
      {# ============== TAB: SETTINGS ============== #}
      <div class="tab-pane active" id="tab-settings">
        <div class="ip-card">
          <div class="ip-head"><h3 class="ip-title"><i class="fa fa-sliders"></i> {{ text_settings }}</h3></div>
          <div class="ip-body">
            <form action="{{ action|replace({'&amp;':'&'})|e('html_attr') }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
              <input type="hidden" name="user_token" value="{{ user_token|e('html_attr') }}">
              <div class="ip-grid">
                <div class="ip-box">
                  <h4><i class="fa fa-power-off"></i> {{ text_section_status }}</h4>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-toggle-on"></i> {{ entry_status }}</label>
                    <select name="module_import_pro_status" class="form-control">
                      <option value="0" {{ not module_import_pro_status ? 'selected' : '' }}>{{ text_disabled }}</option>
                      <option value="1" {{ module_import_pro_status ? 'selected' : '' }}>{{ text_enabled }}</option>
                    </select>
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ text_module_disabled_notice }}</div>
                  </div>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-key"></i> {{ entry_match_field }}</label>
                    <select name="module_import_pro_default_match_field" class="form-control">
                      {% for field in ['model','sku','ean','mpn','upc','jan','isbn'] %}<option value="{{ field|e('html_attr') }}" {{ module_import_pro_default_match_field == field ? 'selected' : '' }}>{{ field }}</option>{% endfor %}
                    </select>
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_match_field }}</div>
                  </div>
                </div>
                <div class="ip-box">
                  <h4><i class="fa fa-picture-o"></i> {{ text_section_images }}</h4>
                  <div class="checkbox"><label><input type="checkbox" name="module_import_pro_download_images" value="1" {{ module_import_pro_download_images ? 'checked="checked"' : '' }}> {{ entry_download_images }}</label></div>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-folder-open"></i> {{ entry_image_subdir }}</label>
                    <input type="text" name="module_import_pro_image_subdir" value="{{ module_import_pro_image_subdir|e('html_attr') }}" class="form-control" placeholder="{{ placeholder_image_subdir|e('html_attr') }}">
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_image_subdir }}</div>
                  </div>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-sort-numeric-asc"></i> {{ entry_image_limit }}</label>
                    <input type="number" min="1" max="100" name="module_import_pro_image_limit" value="{{ module_import_pro_image_limit|e('html_attr') }}" class="form-control" placeholder="10">
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_image_limit }}</div>
                  </div>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-clock-o"></i> {{ entry_url_timeout }}</label>
                    <input type="text" name="module_import_pro_url_timeout" value="{{ module_import_pro_url_timeout|e('html_attr') }}" class="form-control" placeholder="60">
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_url_timeout }}</div>
                  </div>
                </div>
              </div>
              <div class="ip-box" style="margin-top:12px;">
                <h4><i class="fa fa-key"></i> {{ text_section_cron_token }}</h4>
                <input type="text" name="module_import_pro_cron_token" value="{{ module_import_pro_cron_token|e('html_attr') }}" class="form-control">
                <div class="ip-help"><i class="fa fa-shield"></i> {{ help_cron_token }}</div>
              </div>
              <div class="ip-box" style="margin-top:12px;">
                <h4><i class="fa fa-trash"></i> {{ entry_uninstall_delete_data }}</h4>
                <div class="checkbox"><label><input type="checkbox" name="module_import_pro_uninstall_delete_data" value="1" {{ module_import_pro_uninstall_delete_data ? 'checked="checked"' : '' }}> {{ entry_uninstall_delete_data }}</label></div>
                <div class="ip-help"><i class="fa fa-exclamation-triangle"></i> {{ help_uninstall_delete_data }}</div>
              </div>
              <div class="ip-setting-actions">
                <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button>
                <a href="{{ cancel|replace({'&amp;':'&'})|e('html_attr') }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ button_cancel }}</a>
              </div>
            </form>
          </div>
        </div>
      </div>

      {# ============== TAB: PROFILE ============== #}
      <div class="tab-pane" id="tab-profile">
        <div class="ip-card">
          <div class="ip-head"><h3 class="ip-title"><i class="fa fa-list-alt"></i> {{ text_profiles }}</h3><button type="button" class="btn btn-primary btn-sm" id="button-add-profile"><i class="fa fa-plus"></i> {{ button_add_profile }}</button></div>
          <div class="ip-body"><div class="ip-profile-list" id="profiles-table"></div></div>
        </div>
        <div class="ip-card">
          <div class="ip-head"><h3 class="ip-title"><i class="fa fa-pencil"></i> {{ text_section_source }}</h3></div>
          <div class="ip-body">
            <form id="profile-form" class="form-horizontal" onsubmit="return false;">
              <input type="hidden" name="profile_id" value="0">
              <input type="hidden" name="field_map_json" value="{}">
              <div class="ip-grid">
                <div class="ip-box">
                  <h4><i class="fa fa-file-text-o"></i> {{ text_section_source }}</h4>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-tag"></i> {{ entry_profile_name }}</label>
                    <input type="text" name="name" class="form-control" placeholder="{{ placeholder_profile_name|e('html_attr') }}"><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_profile_name }}</div>
                  </div>
                  <div class="ip-grid">
                    <div class="form-group"><label class="control-label"><i class="fa fa-files-o"></i> {{ entry_format }}</label><select name="format" class="form-control">{% for f in ['csv','xlsx','xml','yml','yaml','json','html'] %}<option value="{{ f }}">{{ f|upper }}</option>{% endfor %}</select><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_format }}</div></div>
                    <div class="form-group"><label class="control-label"><i class="fa fa-exchange"></i> {{ entry_source_type }}</label><select name="source_type" class="form-control"><option value="file">{{ text_source_type_file }}</option><option value="url">{{ text_source_type_url }}</option></select><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_source_type }}</div></div>
                  </div>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-link"></i> {{ entry_source_path }}</label>
                    <input type="text" name="source_path" class="form-control" placeholder="{{ placeholder_source_path|e('html_attr') }}">
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_source_path }}</div>
                    <div class="ip-help"><i class="fa fa-globe"></i> {{ help_source_url_example }}</div>
                    <div class="ip-help"><i class="fa fa-folder-open"></i> {{ help_source_file_example }}</div>
                  </div>
                  <input type="file" id="upload-file" class="ip-hidden">
                  <button type="button" class="btn btn-default" id="button-upload"><i class="fa fa-upload"></i> {{ button_upload }}</button>
                </div>
                <div class="ip-box">
                  <h4><i class="fa fa-language"></i> {{ text_section_lang_auth }}</h4>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-flag"></i> {{ entry_default_language }}</label>
                    <select name="default_language_id" class="form-control">{% for language in languages %}<option value="{{ language.language_id }}" {{ language.language_id == default_language_id ? 'selected' : '' }}>{{ language.name|e }} / {{ language.code|e }}</option>{% endfor %}</select>
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_default_language }}</div>
                  </div>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-key"></i> {{ entry_match_field }}</label>
                    <select name="match_field" class="form-control">{% for field in ['model','sku','ean','mpn','upc','jan','isbn','product_id','name'] %}<option value="{{ field }}">{{ field }}</option>{% endfor %}</select>
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_match_field }}</div>
                  </div>
                  <div class="form-group">
                    <label class="control-label"><i class="fa fa-folder"></i> {{ entry_image_subdir }}</label>
                    <input type="text" name="image_subdir" class="form-control" placeholder="{{ placeholder_image_subdir|e('html_attr') }}">
                    <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_image_subdir_profile }}</div>
                  </div>
                  <div class="ip-grid-3">
                    <div class="form-group"><label class="control-label"><i class="fa fa-sort-numeric-asc"></i> {{ entry_image_limit }}</label><input type="number" min="1" max="100" name="image_limit" class="form-control" placeholder="10"><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_image_limit }}</div></div>
                    <div class="form-group"><label class="control-label"><i class="fa fa-picture-o"></i> {{ entry_image_update_mode }}</label><select name="image_update_mode" class="form-control"><option value="keep">{{ text_image_update_keep }}</option><option value="main">{{ text_image_update_main }}</option><option value="replace">{{ text_image_update_replace }}</option><option value="append">{{ text_image_update_append }}</option></select><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_image_update_mode }}</div></div>
                    <div class="checkbox"><label><input type="checkbox" name="auto_split_images" value="1"> {{ entry_auto_split_images }}</label><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_auto_split_images }}</div></div>
                  </div>
                  <div class="ip-grid-3">
                    <div class="form-group"><label class="control-label"><i class="fa fa-lock"></i> {{ entry_auth_type }}</label><select name="auth_type" class="form-control"><option value="none">{{ text_auth_none }}</option><option value="basic">{{ text_auth_basic }}</option></select><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_auth_type }}</div></div>
                    <div class="form-group"><label class="control-label"><i class="fa fa-user"></i> {{ entry_auth_username }}</label><input type="text" name="auth_username" class="form-control" placeholder="user"><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_auth_username }}</div></div>
                    <div class="form-group"><label class="control-label"><i class="fa fa-key"></i> {{ entry_auth_password }}</label><input type="password" name="auth_password" class="form-control" placeholder="password" autocomplete="new-password"><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_auth_password }}</div><div class="ip-help ip-auth-password-saved" style="display:none;"><i class="fa fa-check-circle"></i> {{ text_auth_password_saved }}</div></div>
                  </div>
                  <div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_auth_basic }}</div>
                </div>
              </div>
              <div class="ip-box" style="margin-top:12px;">
                <h4><i class="fa fa-truck"></i> {{ text_section_supplier }}</h4>
                <div class="checkbox"><label><input type="checkbox" name="supplier_mode" value="1"> {{ entry_supplier_mode }}</label><div class="ip-help"><i class="fa fa-info-circle"></i> {{ help_supplier_mode }}</div></div>
                <div class="ip-grid-4">
